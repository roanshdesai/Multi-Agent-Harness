# Subscription-only: there are NO model API keys here.
#   Claude      → sign in once in Claude Code: run `claude`, then /login (your Claude Pro/Max account)
#   GPT-6 Astra → sign in once with `npx codex login` (Sign in with ChatGPT)
# Any ANTHROPIC_API_KEY / OPENAI_API_KEY in your shell is ignored by the harness.

# GitHub MCP (fine-grained PAT)
GITHUB_TOKEN=

# Slack MCP
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=

# Outlook / Microsoft 365 mail MCP (device-code login on first run)
MS365_MCP_CLIENT_ID=
MS365_MCP_TENANT_ID=common

# Scraping / search
FIRECRAWL_API_KEY=
EXA_API_KEY=

# Hindsight memory server (run with docker compose, see README)
HINDSIGHT_MCP_URL=http://localhost:8888/mcp/
